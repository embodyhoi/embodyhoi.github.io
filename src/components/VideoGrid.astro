---
/** Responsive grid for ClipCards: 1 column on phones, `cols` on wide screens. */
interface Props {
  cols?: 2 | 3 | 4;
}
const { cols = 3 } = Astro.props;
const colClass = { 2: "md:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3", 4: "sm:grid-cols-2 lg:grid-cols-4" }[cols];
---

<div class:list={["not-prose my-6 grid grid-cols-1 gap-4", colClass]}>
  <slot />
</div>
